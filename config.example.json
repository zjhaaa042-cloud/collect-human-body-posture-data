{
  "camera": {
    "width": 640,
    "height": 480,
    "fps": 30,
    "align_mode": "D2C_HW",
    "params_file": "config/camera_params.json"
  },
  "voice": {
    "enabled": true,
    "model_path": "models/vosk-model-cn",
    "language": "zh",
    "tts_voice": "zh-CN-XiaoxiaoNeural",
    "tts_rate": "+0%",
    "tts_volume": "+0%"
  },
  "storage": {
    "output_dir": "data",
    "save_rgb": true,
    "save_depth": true,
    "save_pointcloud": true,
    "colored_pointcloud": true,
    "quality_check": true,
    "min_depth_coverage": 0.3,
    "min_color_brightness": 30,
    "max_color_brightness": 220
  },
  "distance": {
    "target_distance_mm": 1000,
    "tolerance_mm": 200,
    "roi_ratio": 0.3
  },
  "gui": {
    "preview_fps": 15,
    "preview_width": 320,
    "preview_height": 240,
    "jpeg_quality": 70
  },
  "websocket_host": "localhost",
  "websocket_port": 8765,
  "log_level": "INFO",
  "log_file": "logs/app.log"
}
