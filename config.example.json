{
  "camera": {
    "width": 1280,
    "height": 800,
    "fps": 30,
    "align_mode": "D2C_HW",
    "orientation": "landscape",
    "calibration_version": "orbbec_d2c_v1",
    "params_file": "config/camera_params.json"
  },
  "voice": {
    "enabled": false,
    "model_path": "models/vosk-model-small-cn-0.22",
    "language": "zh",
    "tts_voice": "zh-CN-XiaoxiaoNeural",
    "tts_rate": "+0%",
    "tts_volume": "+0%"
  },
  "storage": {
    "output_dir": "data",
    "save_rgb": true,
    "save_depth": true,
    "save_pointcloud": true,
    "colored_pointcloud": true,
    "pointcloud_binary": true,
    "pointcloud_stride": 1,
    "quality_check": true,
    "min_depth_coverage": 0.3,
    "min_color_brightness": 30,
    "max_color_brightness": 220
  },
  "distance": {
    "target_distance_mm": 1500,
    "tolerance_mm": 300,
    "roi_ratio": 0.3,
    "min_distance_mm": 1300,
    "max_distance_mm": 2000,
    "min_edge_margin": 0.04,
    "min_body_depth_coverage": 0.75,
    "min_quality_score": 80,
    "pose_model_path": "models/pose_landmarker_full.task"
  },
  "gui": {
    "preview_fps": 20,
    "preview_width": 320,
    "preview_height": 240,
    "jpeg_quality": 50
  },
  "websocket_host": "127.0.0.1",
  "websocket_port": 8765,
  "log_level": "INFO",
  "log_file": "logs/app.log"
}
