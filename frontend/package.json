{
  "name": "body-posture-collector",
  "version": "1.0.2",
  "description": "人体体态数据采集系统",
  "main": "electron-main.js",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000 --open",
    "start:no-open": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build && node scripts/check-electron-build.mjs",
    "test": "node --test src/protocol/protocolUtils.test.mjs src/collector/collectorState.test.mjs",
    "eject": "react-scripts eject",
    "electron:dev": "electron . --dev",
    "electron:build": "npm run build && electron-builder --win nsis",
    "electron:build:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.3",
    "antd": "^5.12.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "com.bodyposture.collector",
    "productName": "体态数据采集系统",
    "asar": true,
    "files": [
      "build/**/*",
      "electron-main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../dist/body-posture-backend",
        "to": "backend"
      },
      {
        "from": "../config",
        "to": "backend-assets/config"
      },
      {
        "from": "../config.example.json",
        "to": "backend-assets/config.example.json"
      },
      {
        "from": "../models",
        "to": "backend-assets/models",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "artifactName": "BodyPostureCollector-Setup-${version}.${ext}",
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "体态数据采集系统"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
